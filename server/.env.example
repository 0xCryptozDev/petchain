# PetChain server — ตัวอย่างค่า ห้าม commit ไฟล์ .env จริง
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/petchain?schema=public"

# Sepolia (Project.md §17.2)
SEPOLIA_RPC_URL="https://<rpc-provider>/v3/<YOUR_KEY>"
CHAIN_ID=11155111
# เติมหลัง deploy จริง — ห้ามใส่ address สมมติ
CONTRACT_ADDRESS=
DEPLOYMENT_BLOCK=

# HMAC key สำหรับ chip token (Project.md §5) — เก็บเป็นความลับ เปลี่ยนต้องมี migration plan
CHIP_HMAC_KEY=
# Session signing secret
SESSION_SECRET=
