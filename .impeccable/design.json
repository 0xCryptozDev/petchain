      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:4px;background:#fff;padding:16px;border-radius:16px;box-shadow:0 4px 16px rgba(0,0,0,.04)}.ds-nav button{font-family:\"Noto Sans Thai\",Tahoma,sans-serif;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:6px 8px;border:0;border-radius:10px;background:transparent;color:#756354;font-size:13px;line-height:20px;font-weight:500;cursor:pointer;transition:background-color 150ms ease-out}.ds-nav button[aria-current]{background:#f1e4d4;color:#392e28;font-weight:600}.ds-nav button:hover{background:#faf3ea;color:#392e28}.ds-nav button:focus-visible{outline:2px solid #c64f29;outline-offset:4px}.ds-nav span{font-size:12px;color:#756354;font-variant-numeric:tabular-nums}"
