      "html": "<button class=\"ds-select\" role=\"combobox\" aria-label=\"บทบาทสาธิต\" aria-expanded=\"false\" aria-haspopup=\"listbox\"><span>สัตวแพทย์</span><svg viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m5 7 5 5 5-5\"/></svg></button>",
      "css": ".ds-select{font-family:\"Noto Sans Thai\",Tahoma,sans-serif;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:space-between;gap:12px;width:180px;min-height:44px;padding:6px 8px;border:1px solid #eadfd2;border-radius:12px;background:transparent;color:#392e28;font-size:12px;line-height:16px;cursor:pointer}.ds-select svg{width:16px;height:16px;color:#756354}.ds-select:hover{border-color:#c64f29}.ds-select:focus-visible{outline:2px solid #c64f29;outline-offset:4px;}.ds-select:disabled{opacity:.5;cursor:not-allowed}@media(max-width:767px){.ds-select{min-height:44px}}"
    },
    {
